          "postmaster",
          "info",
          "sales"
        ]
      }
    },
    "imap": {
      "enabled": true,
      "port": 143,
      "fakeAuth": {
        "mode": "random",
        "acceptProbability": 0.15,
        "acceptedUsernames": [
          "admin",
          "root",
          "info",
          "test",
          "user"
        ]
      }
    },
    "pop3": {
      "enabled": true,
      "port": 110,
      "fakeAuth": {
        "mode": "random",
        "acceptProbability": 0.15,
        "acceptedUsernames": [
          "admin",
          "root",
          "info",
          "test",
          "user"
        ]
      }
    },
    "memcached": {
      "enabled": true,
      "port": 11211,
      "serverVersion": "1.6.24"
    },
    "ldap": {
      "enabled": true,
      "port": 389,
      "fakeAuth": {
        "mode": "random",
        "acceptProbability": 0.15,
        "acceptedUsernames": [
          "admin",
          "administrator",
          "ldapadmin",
          "root",
          "svc-ldap"
        ]
      }
    },
    "rsync": {
      "enabled": true,
      "port": 873
    },
    "adb": {
      "enabled": true,
      "port": 5555,
      "hostname": "generic_x86"
    },
    "squid": {
      "enabled": true,
      "port": 3128,
      "serverHeader": "squid/6.6"
    },
    "http-proxy": {
      "enabled": true,
      "port": 8080,
      "serverHeader": "squid/6.6"
    },
    "socks": {
      "enabled": true,
      "port": 1080,
      "fakeAuth": {
        "mode": "random",
        "acceptProbability": 0.15,
        "acceptedUsernames": [
          "proxy",
          "admin",
          "user",
          "root"
        ]
